{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "f-control flasher",
  "version": "0.1.0",
  "identifier": "app.fcontrol.flasher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "f-control flasher",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0C0C0B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Writes f-control firmware to an ESP32",
    "longDescription": "Writes the f-control firmware image to a bare ESP32 board over USB. The board generates its own keypair on first boot, and no key material ever reaches this computer."
  }
}
